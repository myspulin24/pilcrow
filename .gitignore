# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
src-tauri/target/
src-tauri/gen/

# Secrets & local config -- never commit these
.env
.env.local
.env.*.local

# Podpisové klíče aktualizací a certifikát pro podpis kódu. Ty žijí mimo
# repozitář (~/.reader-mj-keys), tohle je pojistka pro případ, že by je někdo
# vygeneroval sem. `.pfx` nese i soukromý klíč, takže by z něj šlo podepsat
# cokoli tvým jménem.
*.key
updater.key*
*.pfx
*.p12
!src-tauri/nsis/*.nsh

# Local user data (a vault should never live inside the repo, but be explicit).
# Kotva na začátku je podstatná: bez ní by pravidlo sežralo i src/vault/.
/vault/
*.sqlite
*.sqlite-wal
*.sqlite-shm

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.log
npm-debug.log*

# Test output
coverage/
